APP_API_TOKEN=
DATABASE_URL=sqlite:///./backend/data/case_linking.db
STORAGE_DIR=./backend/private_uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=200
OCR_LANGUAGES=eng+hin+mar
OCR_DEVICE=auto
OCR_DPI=180
# Fast default: PaddleOCR only. Set true for EasyOCR cross-verification.
OCR_SECONDARY_VERIFICATION=false
# Fast default: do not retry pages with no detected words at another rotation.
OCR_RETRY_ROTATED_PAGES=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000/api
